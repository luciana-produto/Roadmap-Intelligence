# Modelo de variáveis de ambiente para rodar o ProductHub localmente.
# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NÃO deve ser commitado (já está no .gitignore).

# Senha do SA do container SQL Server local (defina uma senha forte)
SA_PASSWORD=troque-por-uma-senha-forte

# Connection string usada pela API para o banco SQL Server
# Ex.: Server=host,1433;Database=ProductHub;User ID=usuario;Password=senha;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30
ConnectionStrings__SqlServer=
